# Copy to .env (never commit it). One of the two auth options:
GOOGLE_API_KEY=your-gemini-api-key            # Google AI Studio key
# GOOGLE_GENAI_USE_VERTEXAI=true              # or Vertex AI:
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash
# LEADGEN_SEARCH=google                       # lead-gen researchers use Google Search grounding instead of the synthetic corpus
# GEMINI_CLI_BIN=/path/to/gemini              # default: `gemini` on PATH (npm i -g @google/gemini-cli)
